# Citeframe Web BFF local-development template.
# Copy to apps/web/.env.local and replace the signing secret before sharing the environment.

AI_PDF_API_BASE_URL=http://127.0.0.1:8000
AI_PDF_API_INTERNAL_TOKEN=change-me-shared-with-web
AI_PDF_SESSION_SECRET=replace-with-a-long-random-local-session-signing-secret
