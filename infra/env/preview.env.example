# Citeframe local PREVIEW profile
# Copy to: infra/env/preview.local.env  (gitignored)
# Purpose: daily product UI / PDF Q&A with a real generation provider.
# Never point generation at the M403B acceptance stub (18081).

CITEFRAME_ENV=preview

# --- shared infra (compose.yml defaults) ---
AI_PDF_DATABASE_URL=postgresql+psycopg://ai_pdf:ai_pdf_dev@127.0.0.1:5432/ai_pdf_workspace
AI_PDF_MINIO_ENDPOINT=127.0.0.1:9010
AI_PDF_MINIO_ACCESS_KEY=minioadmin
AI_PDF_MINIO_SECRET_KEY=minioadmin
AI_PDF_API_INTERNAL_TOKEN=change-me-shared-with-web

# --- generation: REAL provider only ---
AI_PDF_GENERATION_PROVIDER=openai
AI_PDF_GENERATION_MODEL=gpt-5.5
AI_PDF_OPENAI_API_BASE=http://127.0.0.1:8317/v1
# Use CLIProxy local api-keys as AI_PDF_OPENAI_API_KEY (not SourcesData sk-).
# Put the real key in preview.local.env (gitignored).

# --- image caption follows generation OpenAI base ---
AI_PDF_IMAGE_CAPTION_PROVIDER=openai
AI_PDF_IMAGE_CAPTION_MODEL=gpt-5.5

# --- embedding ---
# Prefer a real local Ollama when available (default below).
# If this database was indexed against the acceptance stub, temporarily keep:
#   AI_PDF_OLLAMA_BASE_URL=http://127.0.0.1:18081
# until you reindex all assets against the new embedding endpoint.
AI_PDF_EMBEDDING_PROVIDER=ollama
AI_PDF_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_PDF_EMBEDDING_VERSION=embedding-v1
AI_PDF_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- retrieval ---
AI_PDF_RETRIEVAL_STRATEGY=hybrid
# ASR for audio/video ingest (OpenAI-compatible key)
AI_PDF_ASR_PROVIDER=openai
AI_PDF_ASR_MODEL=whisper-1
AI_PDF_ASR_VERSION=asr-v1

